# Shared formatting rules; analyzers and formatters read these, so keep them authoritative.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false

[*.{json,toml,yml,yaml}]
indent_size = 2
